<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content="Wrestle with math together" />
    <meta property="og:image" content="/images/mathland.jpg" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PaperLand" />
    <meta name="theme-color" content="#ff9933" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <.live_title suffix=" · Dojo">
      {assigns[:page_title] || "PaperLand"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- keep journal worker — digested path for the durability door (id:kb-6).
         IIFE cannot resolve import.meta.url; the door reads this meta. --%>
    <meta name="keep-journal-worker" content={~p"/assets/js/keep/journal.worker.js"} />
    <%!-- id:assets-boot-witness · a bundle that cannot parse never runs, so the
         only witness left is this listener. ES5 only: it must survive the engines
         the bundle rejects. Writes one plausible event, then gets out of the way. --%>
    <script>
      (function () {
        var seen = false;
        window.plausible = window.plausible || function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
        function isBundleUrl(url) {
          return typeof url === "string" && url.indexOf("/assets/js/") >= 0;
        }
        function notice(message, url) {
          if (seen) return;
          seen = true;
          window.plausible("js-boot-failure", {
            props: {
              url: String(url || ""),
              message: String(message || ""),
              ua: String(navigator.userAgent || "")
            }
          });
          if (document.readyState === "complete") return;
          var bar = document.createElement("div");
          bar.setAttribute("role", "alert");
          bar.style.cssText = "position:fixed;left:0;right:0;top:0;z-index:2147483647;padding:12px 16px;font:14px/1.45 system-ui,-apple-system,sans-serif;background:#3d1f1f;color:#fff;border-bottom:2px solid #ff9933;cursor:pointer";
          var strong = document.createElement("strong");
          strong.textContent = "This browser cannot run PaperLand. ";
          var body = document.createElement("span");
          body.textContent = "The page script did not start, so nothing below works — updating the browser fixes it. Details: "
            + (message || "no message") + " (" + (url || "unknown script") + ") — "
            + String(navigator.userAgent || "").slice(0, 120);
          bar.appendChild(strong);
          bar.appendChild(body);
          bar.onclick = function () { if (bar.parentNode) bar.parentNode.removeChild(bar); };
          (document.body || document.documentElement).appendChild(bar);
        }
        window.addEventListener("error", function (event) {
          var target = event.target || {};
          var url = event.filename || target.src || "";
          if (isBundleUrl(url)) return notice(event.message || "script did not start", url);
          if (target.tagName === "SCRIPT" && isBundleUrl(target.src)) return notice("script failed to load", target.src);
          if (event.message && /is not a function|is not defined|is not supported/i.test(event.message)) {
            notice(event.message, url || location.href);
          }
        }, true);
        window.addEventListener("unhandledrejection", function (event) {
          var reason = (event && event.reason) || {};
          var message = String((reason && reason.message) || reason || "");
          if (/is not a function|is not defined|is not supported|structuredClone|hasOwn/.test(message)) {
            notice(message, location.href);
          }
        });
      })();
    </script>
    <script
      defer
      fetchpriority="high"
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/app.js"}
    >
    </script>
    <script>
      (() => {
        const sess = JSON.parse(localStorage.getItem("session") || "{}");
        const locale = sess.settings && sess.settings.locale;
        if (locale) document.documentElement.lang = locale;
      })();
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "dark");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => setTheme(theme));
      })();
    </script>
    <script
      defer
      data-domain="dojo.paperland.sg"
      src="https://odin.fly.dev/js/script.file-downloads.hash.outbound-links.pageview-props.tagged-events.js"
    >
    </script>
  </head>
  <body class="">
    {@inner_content}
  </body>
</html>
